#!/usr/bin/env python3
"""status-dashboard — the in-harness orchestration UI.

Renders work completed / in progress / todo from the harness's own tracking
artifacts, so an orchestrator (AVRIL, AXEL, rust-team-lead, or a generated
orchestrator prompt) can refresh a single view as it makes progress.

Usage:
    scripts/status-dashboard                 # terminal summary
    scripts/status-dashboard --html          # also write docs/status-dashboard.html
    scripts/status-dashboard --html-only     # write the HTML, print nothing
    scripts/status-dashboard --out PATH      # HTML destination
    scripts/status-dashboard --root DIR      # project root (default: repo root)
    scripts/status-dashboard --config PATH   # tracker config (default: dashboard.config.json)
    scripts/status-dashboard --markdown      # markdown, for pasting into chat
    scripts/status-dashboard --root A --root B ...   # portfolio across projects

Sources, all optional and read-only — a missing one degrades to empty:
    features.json      phases -> commits -> features
    pinto list --json  board items, when pinto is installed
    progress.md        tail, for the last recorded activity

A project whose tracker uses different words or a different board CLI supplies
`dashboard.config.json` (see DEFAULT_CONFIG below). Without one, the defaults
above apply unchanged. The board command is run as an argv list, never through a
shell, so a config cannot inject shell syntax — but it does name a program this
script will execute, so treat it with the same trust as a justfile.

Structure follows the repo's own philosophy: reading sources are actions,
everything that shapes or renders the model is a pure calculation.
"""

from __future__ import annotations

import argparse
import datetime as _datetime
import html
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

DONE = "done"
ACTIVE = "active"
TODO = "todo"

DEFAULT_CONFIG = {
    # Status vocabularies. Anything unmatched is todo, so only done and active
    # need listing. Compared case-insensitively with -/_/space normalised.
    "status_map": {
        "done": ["completed", "complete", "done", "verified", "merged", "shipped"],
        "active": ["in progress", "inprogress", "building", "built", "review",
                   "in review", "started", "wip", "regressed"],
    },
    # Board source. `command` is an argv list, run without a shell.
    # `items_path` walks into the payload; "" means the payload is the list.
    # `fields` maps our id/title/status onto the tracker's own key names.
    "board": {
        "command": ["pinto", "list", "--json"],
        "items_path": "",
        "fields": {"id": "id", "title": "title", "status": "status"},
    },
    "features_file": "features.json",
    "progress_file": "progress.md",
}


def normalise(word: str) -> str:
    """Fold -, _ and whitespace so 'in-progress' == 'in_progress' == 'In Progress'."""
    return re.sub(r"[\s_-]+", " ", (word or "").strip().lower())


def load_config(root: Path, path: str | None) -> dict:
    """Merge a project config over the defaults. A broken config is reported, not swallowed."""
    candidate = Path(path) if path else (root / "dashboard.config.json")
    if not candidate.is_absolute():
        candidate = root / candidate
    if not candidate.exists():
        return DEFAULT_CONFIG
    raw = json.loads(candidate.read_text())
    cfg = {**DEFAULT_CONFIG, **raw}
    cfg["status_map"] = {**DEFAULT_CONFIG["status_map"], **raw.get("status_map", {})}
    cfg["board"] = {**DEFAULT_CONFIG["board"], **raw.get("board", {})}
    cfg["board"]["fields"] = {**DEFAULT_CONFIG["board"]["fields"],
                              **raw.get("board", {}).get("fields", {})}
    return cfg


# ---------------------------------------------------------------- calculations

def classify(status: str, status_map: dict | None = None) -> str:
    """Map a tracker's status vocabulary onto done / active / todo."""
    m = status_map or DEFAULT_CONFIG["status_map"]
    s = normalise(status)
    if s in {normalise(w) for w in m.get("done", [])}:
        return DONE
    if s in {normalise(w) for w in m.get("active", [])}:
        return ACTIVE
    return TODO


def phases_from_features(features: dict, status_map: dict | None = None) -> list[dict]:
    """Shape features.json into ordered phases with per-commit classification."""
    phases = []
    for name, body in features.items():
        if not isinstance(body, dict):
            continue
        commits = [c for c in body.get("commits", []) if isinstance(c, dict)]
        items = [
            {
                "id": c.get("id", "?"),
                "title": c.get("title", ""),
                "state": classify(c.get("status", ""), status_map),
                "features": len(c.get("features") or []),
            }
            for c in commits
        ]
        done = sum(1 for i in items if i["state"] == DONE)
        phases.append({
            "name": name,
            "state": classify(body.get("status", ""), status_map),
            "items": items,
            "done": done,
            "total": len(items),
            "percent": round(100 * done / len(items)) if items else (
                100 if classify(body.get("status", ""), status_map) == DONE else 0),
        })
    phases.sort(key=lambda p: ({DONE: 2, ACTIVE: 0, TODO: 1}[p["state"]], p["name"]))
    return phases


def dig(node: object, path: str) -> object:
    """Follow a dotted key path. Trackers nest (GitHub Projects puts title under content)."""
    for key in [k for k in (path or "").split(".") if k]:
        if not isinstance(node, dict):
            return None
        node = node.get(key)
    return node


def board_items(raw: object, board_cfg: dict | None = None,
                status_map: dict | None = None) -> list[dict]:
    """Shape any board payload into items, per the config's path and field names."""
    cfg = board_cfg or DEFAULT_CONFIG["board"]
    node = dig(raw, cfg.get("items_path") or "") if cfg.get("items_path") else None
    if node is None:
        node = raw if isinstance(raw, list) else (raw or {}).get("tasks", [])
    f = cfg.get("fields", DEFAULT_CONFIG["board"]["fields"])
    return [
        {
            "id": dig(t, f["id"]) or "?",
            "title": dig(t, f["title"]) or "",
            "state": classify(dig(t, f["status"]) or "", status_map),
            "status": dig(t, f["status"]) or "",
        }
        for t in node if isinstance(t, dict)
    ]


# Kept so existing callers and tests keep working.
def board_from_pinto(raw: object) -> list[dict]:
    return board_items(raw)


def totals(phases: list[dict], board: list[dict]) -> dict:
    """Count units of work by state. Board items win when both are present."""
    units = board if board else [i for p in phases for i in p["items"]]
    return {
        DONE: sum(1 for u in units if u["state"] == DONE),
        ACTIVE: sum(1 for u in units if u["state"] == ACTIVE),
        TODO: sum(1 for u in units if u["state"] == TODO),
        "source": "board" if board else "features.json",
    }


def build_model(features: dict, pinto_raw: object, progress_tail: str,
                project: str, generated: str, config: dict | None = None) -> dict:
    cfg = config or DEFAULT_CONFIG
    sm = cfg.get("status_map")
    phases = phases_from_features(features, sm)
    board = board_items(pinto_raw, cfg.get("board"), sm)
    return {
        "project": project,
        "generated": generated,
        "phases": phases,
        "board": board,
        "totals": totals(phases, board),
        "progress_tail": progress_tail,
    }


# ------------------------------------------------------------------- rendering

MARK = {DONE: "✔", ACTIVE: "▶", TODO: "○"}
LABEL = {DONE: "completed", ACTIVE: "in progress", TODO: "todo"}


def render_terminal(model: dict) -> str:
    t = model["totals"]
    out = [
        "",
        f"  {model['project']} — orchestration status",
        f"  {model['generated']}",
        "",
        f"  {MARK[DONE]} completed {t[DONE]:>3}"
        f"    {MARK[ACTIVE]} in progress {t[ACTIVE]:>3}"
        f"    {MARK[TODO]} todo {t[TODO]:>3}"
        f"    (from {t['source']})",
    ]

    if model["phases"]:
        out += ["", "  PHASES"]
        for p in model["phases"]:
            bar_len = 16
            filled = round(bar_len * p["percent"] / 100)
            bar = "█" * filled + "·" * (bar_len - filled)
            out.append(f"    {MARK[p['state']]} {p['name'][:34]:<34} "
                       f"{bar} {p['done']}/{p['total']}")
            for i in p["items"]:
                if i["state"] != DONE:
                    out.append(f"        {MARK[i['state']]} {i['id']}  {i['title'][:52]}")

    open_items = [b for b in model["board"] if b["state"] != DONE]
    if open_items:
        out += ["", f"  BOARD ({len(open_items)} open)"]
        for b in open_items:
            out.append(f"    {MARK[b['state']]} {b['id']:<6} {b['title'][:56]}")

    if model["progress_tail"]:
        out += ["", "  LAST RECORDED ACTIVITY",
                *(f"    {line}" for line in model["progress_tail"].splitlines()[-3:])]

    out.append("")
    return "\n".join(out)


def _cards(items: list[dict], state: str) -> str:
    tone = {
        DONE: ("emerald", "fa-check"),
        ACTIVE: ("amber", "fa-play"),
        TODO: ("zinc", "fa-circle"),
    }[state]
    if not items:
        return '<div class="text-sm text-zinc-600 italic px-1 py-3">nothing here</div>'
    return "".join(
        f'<div class="bg-zinc-900 border border-zinc-800 rounded-2xl px-4 py-3">'
        f'<div class="flex items-center gap-2">'
        f'<i class="fa-solid {tone[1]} text-{tone[0]}-400 text-xs"></i>'
        f'<span class="font-mono text-xs text-zinc-500">{html.escape(str(i["id"]))}</span>'
        f'</div>'
        f'<div class="text-sm text-zinc-200 mt-1 leading-snug">{html.escape(i["title"])}</div>'
        f'</div>'
        for i in items
    )


def render_html(model: dict) -> str:
    t = model["totals"]
    units = model["board"] or [i for p in model["phases"] for i in p["items"]]
    by = {s: [u for u in units if u["state"] == s] for s in (DONE, ACTIVE, TODO)}
    total = max(len(units), 1)

    phase_rows = "".join(
        f'<div class="py-3 border-b border-zinc-800/60 last:border-0">'
        f'<div class="flex items-center justify-between gap-4">'
        f'<div class="flex items-center gap-2 min-w-0">'
        f'<i class="fa-solid {"fa-check text-emerald-400" if p["state"] == DONE else ("fa-play text-amber-400" if p["state"] == ACTIVE else "fa-circle text-zinc-600")} text-xs"></i>'
        f'<span class="text-sm text-zinc-200 truncate">{html.escape(p["name"])}</span>'
        f'</div>'
        f'<span class="text-xs text-zinc-500 tabular-nums shrink-0">{p["done"]}/{p["total"]}</span>'
        f'</div>'
        f'<div class="h-1.5 bg-zinc-800 rounded-full mt-2 overflow-hidden">'
        f'<div class="h-full rounded-full {"bg-emerald-500" if p["percent"] == 100 else "bg-amber-500"}" style="width:{p["percent"]}%"></div>'
        f'</div></div>'
        for p in model["phases"]
    ) or '<div class="text-sm text-zinc-600 italic">no features.json phases</div>'

    def pct(n): return round(100 * n / total)

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{html.escape(model['project'])} — orchestration status</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-zinc-950 text-zinc-200 antialiased">
<div class="max-w-6xl mx-auto px-6 py-12">

  <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
    <div>
      <div class="text-3xl font-semibold tracking-tighter">{html.escape(model['project'])}</div>
      <div class="text-sm text-zinc-500 mt-1">Orchestration status · generated from {html.escape(t['source'])}</div>
    </div>
    <div class="text-xs text-zinc-600 font-mono">{html.escape(model['generated'])}</div>
  </div>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-emerald-400 tabular-nums">{t[DONE]}</div>
      <div class="text-sm text-zinc-400 mt-1">completed</div>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-amber-400 tabular-nums">{t[ACTIVE]}</div>
      <div class="text-sm text-zinc-400 mt-1">in progress</div>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-zinc-400 tabular-nums">{t[TODO]}</div>
      <div class="text-sm text-zinc-400 mt-1">todo</div>
    </div>
  </div>

  <div class="flex h-2 rounded-full overflow-hidden mb-10 bg-zinc-800">
    <div class="bg-emerald-500" style="width:{pct(len(by[DONE]))}%"></div>
    <div class="bg-amber-500" style="width:{pct(len(by[ACTIVE]))}%"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
    <div>
      <div class="text-xs uppercase tracking-widest text-emerald-400/80 mb-3">Completed · {len(by[DONE])}</div>
      <div class="space-y-2">{_cards(by[DONE], DONE)}</div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-widest text-amber-400/80 mb-3">In progress · {len(by[ACTIVE])}</div>
      <div class="space-y-2">{_cards(by[ACTIVE], ACTIVE)}</div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Todo · {len(by[TODO])}</div>
      <div class="space-y-2">{_cards(by[TODO], TODO)}</div>
    </div>
  </div>

  <div class="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-6 mb-6">
    <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Phases</div>
    {phase_rows}
  </div>

  <div class="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-6">
    <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Last recorded activity</div>
    <pre class="text-xs text-zinc-400 whitespace-pre-wrap font-mono leading-relaxed">{html.escape(model['progress_tail'] or '(no progress.md)')}</pre>
  </div>

  <div class="text-xs text-zinc-700 mt-8">
    Regenerate with <span class="font-mono text-zinc-500">just status-html</span>. This file is generated — do not edit by hand.
  </div>

</div>
</body>
</html>
"""


def _bar(percent: int, width: int = 10) -> str:
    filled = round(width * percent / 100)
    return "█" * filled + "░" * (width - filled)


def render_markdown(model: dict) -> str:
    """One project, as markdown a chat client will render."""
    t = model["totals"]
    out = [
        f"**{model['project']}** — orchestration status  ",
        f"`{model['generated']}` · source: {t['source']}",
        "",
        f"| ✅ completed | 🟡 in progress | ⬜ todo |",
        f"|---:|---:|---:|",
        f"| {t[DONE]} | {t[ACTIVE]} | {t[TODO]} |",
    ]
    if model["phases"]:
        out += ["", "| phase | progress | |", "|---|---|---:|"]
        for p in model["phases"]:
            out.append(f"| {p['name']} | `{_bar(p['percent'])}` | {p['done']}/{p['total']} |")
    open_items = [b for b in model["board"] if b["state"] != DONE]
    if open_items:
        out += ["", f"**Open board items ({len(open_items)})**", "", "| | id | title |", "|---|---|---|"]
        for b in open_items[:15]:
            out.append(f"| {'🟡' if b['state'] == ACTIVE else '⬜'} | `{b['id']}` | {b['title']} |")
        if len(open_items) > 15:
            out.append(f"| | | _+{len(open_items) - 15} more_ |")
    return "\n".join(out)


def build_portfolio(models: list[dict], generated: str) -> dict:
    """Aggregate several project models. Pure: no reading, no formatting."""
    agg = {DONE: 0, ACTIVE: 0, TODO: 0}
    for m in models:
        for k in (DONE, ACTIVE, TODO):
            agg[k] += m["totals"][k]
    return {"projects": models, "totals": agg, "generated": generated,
            "count": len(models)}


def render_portfolio_markdown(pf: dict) -> str:
    a = pf["totals"]
    total = max(a[DONE] + a[ACTIVE] + a[TODO], 1)
    out = [
        f"## Portfolio status — {pf['count']} projects  ",
        f"`{pf['generated']}`",
        "",
        "| ✅ completed | 🟡 in progress | ⬜ todo | done |",
        "|---:|---:|---:|---:|",
        f"| {a[DONE]} | {a[ACTIVE]} | {a[TODO]} | {round(100 * a[DONE] / total)}% |",
        "",
        "| project | ✅ | 🟡 | ⬜ | progress | source |",
        "|---|---:|---:|---:|---|---|",
    ]
    for m in pf["projects"]:
        t = m["totals"]
        n = max(t[DONE] + t[ACTIVE] + t[TODO], 1)
        out.append(f"| **{m['project']}** | {t[DONE]} | {t[ACTIVE]} | {t[TODO]} | "
                   f"`{_bar(round(100 * t[DONE] / n))}` | {t['source']} |")
    active = [(m["project"], b) for m in pf["projects"]
              for b in m["board"] if b["state"] == ACTIVE]
    if active:
        out += ["", "**In progress right now**", "", "| project | id | title |", "|---|---|---|"]
        for proj, b in active:
            out.append(f"| {proj} | `{b['id']}` | {b['title']} |")
    return "\n".join(out)


def render_portfolio_html(pf: dict) -> str:
    a = pf["totals"]
    total = max(a[DONE] + a[ACTIVE] + a[TODO], 1)
    rows = ""
    for m in pf["projects"]:
        t = m["totals"]
        n = max(t[DONE] + t[ACTIVE] + t[TODO], 1)
        pct = round(100 * t[DONE] / n)
        rows += (
            f'<div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">'
            f'<div class="flex items-baseline justify-between gap-3">'
            f'<div class="font-semibold text-zinc-100 truncate">{html.escape(m["project"])}</div>'
            f'<div class="text-xs text-zinc-600 shrink-0">{html.escape(m["totals"]["source"])}</div></div>'
            f'<div class="flex gap-4 mt-3 text-sm tabular-nums">'
            f'<span class="text-emerald-400">{t[DONE]}</span>'
            f'<span class="text-amber-400">{t[ACTIVE]}</span>'
            f'<span class="text-zinc-500">{t[TODO]}</span></div>'
            f'<div class="h-1.5 bg-zinc-800 rounded-full mt-3 overflow-hidden">'
            f'<div class="h-full rounded-full {"bg-emerald-500" if pct == 100 else "bg-amber-500"}" style="width:{pct}%"></div>'
            f'</div></div>'
        )
    active = "".join(
        f'<tr class="border-b border-zinc-800/60"><td class="py-2 pr-4 text-zinc-500">{html.escape(m["project"])}</td>'
        f'<td class="py-2 pr-4 font-mono text-xs text-zinc-400">{html.escape(str(b["id"]))}</td>'
        f'<td class="py-2 text-zinc-200">{html.escape(b["title"])}</td></tr>'
        for m in pf["projects"] for b in m["board"] if b["state"] == ACTIVE
    ) or '<tr><td class="py-2 text-zinc-600 italic" colspan="3">nothing in progress</td></tr>'

    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio status</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head><body class="bg-zinc-950 text-zinc-200 antialiased">
<div class="max-w-6xl mx-auto px-6 py-12">
  <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
    <div><div class="text-3xl font-semibold tracking-tighter">Portfolio status</div>
    <div class="text-sm text-zinc-500 mt-1">{pf['count']} projects</div></div>
    <div class="text-xs text-zinc-600 font-mono">{html.escape(pf['generated'])}</div>
  </div>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5"><div class="text-4xl font-semibold text-emerald-400 tabular-nums">{a[DONE]}</div><div class="text-sm text-zinc-400 mt-1">completed</div></div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5"><div class="text-4xl font-semibold text-amber-400 tabular-nums">{a[ACTIVE]}</div><div class="text-sm text-zinc-400 mt-1">in progress</div></div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5"><div class="text-4xl font-semibold text-zinc-400 tabular-nums">{a[TODO]}</div><div class="text-sm text-zinc-400 mt-1">todo</div></div>
  </div>
  <div class="flex h-2 rounded-full overflow-hidden mb-10 bg-zinc-800">
    <div class="bg-emerald-500" style="width:{round(100 * a[DONE] / total)}%"></div>
    <div class="bg-amber-500" style="width:{round(100 * a[ACTIVE] / total)}%"></div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">{rows}</div>
  <div class="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-6">
    <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">In progress right now</div>
    <table class="w-full text-sm"><tbody>{active}</tbody></table>
  </div>
  <div class="text-xs text-zinc-700 mt-8">Generated — do not edit by hand.</div>
</div></body></html>
"""


# ----------------------------------------------------------------- actions/io

def read_features(root: Path, filename: str = "features.json") -> dict:
    try:
        data = json.loads((root / filename).read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def read_board(root: Path, board_cfg: dict) -> object:
    """Run the configured board command as argv (never through a shell)."""
    cmd = board_cfg.get("command") or []
    if not cmd or not shutil.which(cmd[0]):
        return None
    try:
        done = subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=20)
        return json.loads(done.stdout) if done.returncode == 0 else None
    except Exception:
        return None


def read_progress_tail(root: Path, filename: str = "progress.md", lines: int = 12) -> str:
    try:
        return "\n".join((root / filename).read_text().splitlines()[-lines:])
    except Exception:
        return ""


def read_project(path: Path, config_arg: str | None, generated: str) -> dict:
    """Read one project into a model. The only place actions and calculations meet."""
    cfg = load_config(path, config_arg)
    return build_model(
        features=read_features(path, cfg.get("features_file", "features.json")),
        pinto_raw=read_board(path, cfg.get("board", DEFAULT_CONFIG["board"])),
        progress_tail=read_progress_tail(path, cfg.get("progress_file", "progress.md")),
        project=path.name,
        generated=generated,
        config=cfg,
    )


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__)
    ap.add_argument("--html", action="store_true", help="also write the HTML dashboard")
    ap.add_argument("--html-only", action="store_true", help="write HTML, print nothing")
    ap.add_argument("--markdown", action="store_true", help="print markdown instead of the terminal view")
    ap.add_argument("--out", default="docs/status-dashboard.html")
    ap.add_argument("--root", action="append", default=None,
                    help="project root; repeat for a portfolio across projects")
    ap.add_argument("--config", default=None,
                    help="tracker config (default: dashboard.config.json if present)")
    args = ap.parse_args()

    roots = [Path(r).resolve() for r in (args.root or
             [str(Path(__file__).resolve().parent.parent)])]
    generated = _datetime.datetime.now().strftime("%Y-%m-%d %H:%M")

    models, unread = [], []
    for root in roots:
        if not root.is_dir():
            unread.append((root, "no such directory"))
            continue
        try:
            models.append(read_project(root, args.config, generated))
        except Exception as exc:                      # a bad config must not kill the rest
            unread.append((root, str(exc)))

    if not models:
        for root, why in unread:
            print(f"  unread: {root} — {why}", file=sys.stderr)
        return 2

    portfolio = len(models) > 1
    pf = build_portfolio(models, generated) if portfolio else None

    if args.markdown:
        text = render_portfolio_markdown(pf) if portfolio else render_markdown(models[0])
    else:
        text = ("\n".join(render_terminal(m) for m in models)
                if portfolio else render_terminal(models[0]))

    if args.html or args.html_only:
        out = Path(args.out)
        if not out.is_absolute():
            out = roots[0] / out
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(render_portfolio_html(pf) if portfolio else render_html(models[0]))
        if not args.html_only:
            print(text)
        try:
            shown = out.relative_to(roots[0])
        except ValueError:
            shown = out
        print(f"  → dashboard written to {shown}\n")
    else:
        print(text)

    # Unread projects are reported, never silently dropped.
    for root, why in unread:
        print(f"  unread: {root} — {why}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
