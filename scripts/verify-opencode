#!/usr/bin/env bash
#
# verify-opencode
# Mechanical verification of the project's OpenCode slash-command layer.
#
# Usage:
#   ./scripts/verify-opencode                 # static + live discovery checks
#   ./scripts/verify-opencode --run-preflight # also execute the embedded preflight
#                                             # blocks and require exit 0 + output
#
# Static checks always run (no opencode required):
#   - .opencode layout exists and opencode.jsonc parses as JSON (comments stripped)
#   - agent files declare description + mode: primary
#   - command files declare description + agent: and use $ARGUMENTS
#   - preflight blocks, when present, contain no write commands
#
# Live checks run only when the opencode binary is present (skipped in CI):
#   - `opencode agent list` discovers avril and axel as primary agents
#   - `opencode debug skill` resolves the avril, axel, and code-writer skills
#
# Exit 0 when every check passes or is skipped; 1 on any failure.

set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

RUN_PREFLIGHT=false
if [[ "${1:-}" == "--run-preflight" ]]; then
    RUN_PREFLIGHT=true
fi

FAILED=0
pass() { echo "  ✓ $1"; }
fail() { echo "  ✗ $1"; FAILED=1; }
skip() { echo "  (skip) $1"; }

echo "→ Verifying OpenCode command layer..."
echo ""
echo "Checking .opencode layout..."

# Required core files; every other agent/command found is still checked
# structurally below, so a new command is covered without editing this list.
for f in .opencode/opencode.jsonc \
         .opencode/agent/avril.md .opencode/agent/axel.md \
         .opencode/command/avril.md .opencode/command/axel.md; do
    if [[ -s "$f" ]]; then pass "present $f"; else fail "missing or empty $f"; fi
done

AGENT_FILES=(.opencode/agent/*.md)
COMMAND_FILES=(.opencode/command/*.md)
pass "discovered ${#AGENT_FILES[@]} agent(s), ${#COMMAND_FILES[@]} command(s)"

if python3 - <<'PY'
import json, re, sys
raw = open(".opencode/opencode.jsonc").read()
stripped = re.sub(r"^\s*//.*$", "", raw, flags=re.M)
cfg = json.loads(stripped)
sys.exit(0 if cfg.get("$schema") == "https://opencode.ai/config.json" else 1)
PY
then pass "opencode.jsonc parses and declares \$schema"
else fail "opencode.jsonc invalid or missing \$schema"
fi

echo ""
echo "Checking agent and command frontmatter..."

python3 - <<'PY'
import glob, re, sys

def frontmatter(path):
    text = open(path).read()
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    if not m:
        return None, None
    fields = dict(re.findall(r"^([a-z_]+):[ \t]*(.*)$", m.group(1), re.M))
    return fields, m.group(2)

problems = []

for path in sorted(glob.glob(".opencode/agent/*.md")):
    fields, body = frontmatter(path)
    if fields is None:
        problems.append(f"{path}: no YAML frontmatter"); continue
    if not fields.get("description"):
        problems.append(f"{path}: no description")
    if fields.get("mode") != "primary":
        problems.append(f"{path}: mode is {fields.get('mode')!r}, expected 'primary'")

for path in sorted(glob.glob(".opencode/command/*.md")):
    fields, body = frontmatter(path)
    if fields is None:
        problems.append(f"{path}: no YAML frontmatter"); continue
    if not fields.get("description"):
        problems.append(f"{path}: no description")
    expected = path.split("/")[-1].removesuffix(".md")
    if fields.get("agent") != expected:
        problems.append(f"{path}: agent is {fields.get('agent')!r}, expected {expected!r}")
    if "$ARGUMENTS" not in body:
        problems.append(f"{path}: body does not use $ARGUMENTS")

# Preflight shell injections must stay read-only.
WRITES = ("git commit", "git push", "git add", "git checkout", "git reset", "git merge",
          "pinto add", "pinto move", "pinto set", "pinto update", "pinto automate", "rm ", "mv ")
for path in sorted(glob.glob(".opencode/command/*.md")):
    body = open(path).read()
    for shell in re.findall(r"!`([^`]*)`", body, re.S):
        for w in WRITES:
            if w in shell:
                problems.append(f"{path}: preflight contains write command {w.strip()!r}")

for p in problems:
    print("PROBLEM", p)
sys.exit(1 if problems else 0)
PY
if [[ $? -eq 0 ]]; then
    pass "agent frontmatter: description + mode: primary"
    pass "command frontmatter: description + agent + \$ARGUMENTS"
    pass "command preflight blocks are read-only"
else
    fail "agent/command frontmatter or preflight checks failed (see PROBLEM lines above)"
fi

echo ""
echo "Checking bootstrap template parity..."

TEMPLATE_DIR="templates/harness/opencode"
if [[ -d "$TEMPLATE_DIR" ]]; then
    # Parity is a source-file contract: compare the git-tracked dogfood files
    # against the template, ignoring transient artifacts like node_modules/
    # (gitignored, installed by opencode at runtime).
    for rel in $( git ls-files .opencode | grep -E '\.(md|jsonc)$' | sed 's|^\.opencode/||' | sort ); do
        if [[ ! -f "$TEMPLATE_DIR/$rel" ]]; then
            fail "missing bootstrap template $TEMPLATE_DIR/$rel"
        elif diff -q ".opencode/$rel" "$TEMPLATE_DIR/$rel" >/dev/null 2>&1; then
            pass "template matches dogfood: $rel"
        else
            fail "template drift: $TEMPLATE_DIR/$rel differs from .opencode/$rel"
        fi
    done
else
    skip "no bootstrap templates at $TEMPLATE_DIR"
fi

echo ""
echo "Checking live OpenCode discovery..."

OPENCODE_BIN="${OPENCODE_BIN:-}"
if [[ -z "$OPENCODE_BIN" ]]; then
    if command -v opencode >/dev/null 2>&1; then OPENCODE_BIN="$(command -v opencode)"
    elif [[ -x "$HOME/.opencode/bin/opencode" ]]; then OPENCODE_BIN="$HOME/.opencode/bin/opencode"
    fi
fi

if [[ -z "$OPENCODE_BIN" ]]; then
    skip "opencode not installed — live discovery checks skipped"
else
    # Both `agent list` and `debug skill` emit far more than 64KB, and a shell
    # variable silently truncates at that size, so stream both to temp files.
    AGENTS_TXT="$(mktemp -t opencode-agents)"
    SKILLS_JSON="$(mktemp -t opencode-skills)"
    trap 'rm -f "$AGENTS_TXT" "$SKILLS_JSON"' EXIT
    "$OPENCODE_BIN" agent list --pure > "$AGENTS_TXT" 2>/dev/null

    for f in .opencode/agent/*.md; do
        a="$(basename "$f" .md)"
        if grep -qE "^$a \(primary\)" "$AGENTS_TXT"; then
            pass "opencode discovers agent '$a' (primary)"
        else
            fail "opencode does not discover agent '$a' as primary"
        fi
    done

    "$OPENCODE_BIN" debug skill --pure > "$SKILLS_JSON" 2>/dev/null

    PARSE='import json,sys
try: data=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
items=data if isinstance(data,list) else data.get("skills",[])
print("\n".join(i["name"] for i in items if isinstance(i,dict) and i.get("name")))'
    RESOLVED="$(python3 -c "$PARSE" "$SKILLS_JSON")"

    for s in avril axel code-writer; do
        if grep -qx "$s" <<<"$RESOLVED"; then
            pass "opencode resolves skill '$s'"
        else
            fail "opencode does not resolve skill '$s'"
        fi
    done
fi

if [[ "$RUN_PREFLIGHT" == true ]]; then
    echo ""
    echo "Executing preflight blocks (read-only)..."
    if [[ $FAILED -ne 0 ]]; then
        skip "static checks failed — not executing embedded shell"
    else
        for cmdfile in .opencode/command/*.md; do
            n=0
            while IFS= read -r snippet; do
                n=$((n + 1))
                out="$(eval "$snippet" 2>&1)"
                rc=$?
                if [[ $rc -ne 0 ]]; then
                    fail "$cmdfile preflight #$n exited $rc: $snippet"
                elif [[ -z "$out" ]]; then
                    fail "$cmdfile preflight #$n produced no output: $snippet"
                else
                    pass "$cmdfile preflight #$n ok ($(wc -l <<<"$out" | tr -d ' ') lines)"
                fi
            done < <(python3 -c 'import re,sys;print("\n".join(m.replace("\n"," ") for m in re.findall(r"!`(.*?)`", open(sys.argv[1]).read(), re.S)))' "$cmdfile")
        done
    fi
fi

echo ""
if [[ $FAILED -eq 0 ]]; then
    echo "✓ OpenCode command layer verified."
else
    echo "✗ OpenCode verification failed."
fi
exit $FAILED
